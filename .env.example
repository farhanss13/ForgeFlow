# Database connection settings (Supabase hosted PostgreSQL)
# DATABASE_URL: Transaction connection pooler (Session mode) for application queries
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: Direct, non-pooled connection to the database (used for migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase API URL and public Anon Key
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Google Gemini API configuration for AI Project Planner
GEMINI_API_KEY="your-gemini-api-key-here"

# GitHub OAuth App Configuration for connection integrations
GITHUB_CLIENT_ID="your-github-client-id-here"
GITHUB_CLIENT_SECRET="your-github-client-secret-here"
GITHUB_CALLBACK_URL="http://localhost:3000/api/auth/github/callback"

