datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User Profile model (linked to Supabase Auth)
model Profile {
  id              String            @id @default(uuid()) @db.Uuid
  email           String            @unique
  fullName        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  projects        Project[]
  activityRecords ActivityRecord[]
  githubConnection GitHubConnection?
}

// Project container model
model Project {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  ownerId          String            @db.Uuid
  owner            Profile           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  milestones       Milestone[]
  tasks            Task[]
  documents        Document[]
  activityRecords  ActivityRecord[]
  githubRepository GitHubRepository?

  @@index([ownerId])
}

// Milestone timeline model
model Milestone {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]

  @@index([projectId])
}

// Kanban Task card model
model Task {
  id                String     @id @default(uuid()) @db.Uuid
  projectId         String     @db.Uuid
  project           Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId       String?    @db.Uuid
  milestone         Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  status            String     @default("TODO")      // e.g. "TODO", "IN_PROGRESS", "DONE"
  priority          String     @default("MEDIUM")    // e.g. "LOW", "MEDIUM", "HIGH"
  position          Float      // Ordering index for drag and drop
  dueDate           DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // GitHub integration fields
  githubIssueId     String?
  githubIssueNumber Int?
  githubIssueUrl    String?
  githubIssueTitle  String?

  @@index([projectId])
  @@index([projectId, status])
  @@unique([projectId, githubIssueId])
}

// Technical documentation model
model Document {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

// Audit timeline log model
model ActivityRecord {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?  @db.Uuid
  user      Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt(sort: Desc)])
}

// GitHub OAuth Connection model
model GitHubConnection {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  profile        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubUserId   String   @unique
  githubUsername String
  accessToken    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// GitHub Repository Link model
model GitHubRepository {
  id                 String   @id @default(uuid()) @db.Uuid
  projectId          String   @unique @db.Uuid
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  githubRepositoryId String
  name               String
  fullName           String
  ownerLogin         String
  htmlUrl            String
  description        String?
  defaultBranch      String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([projectId])
}
